# ═══════════════════════════════════════════════════════════
#  FieldForce Pro — Docker Environment Configuration
# ═══════════════════════════════════════════════════════════
#  Copy this file to .env.docker and fill in all values:
#    cp .env.docker.example .env.docker
#    nano .env.docker
# ═══════════════════════════════════════════════════════════

# ── Domain & URLs ──────────────────────────────────────────
WEB_PORT=3123
WEB_URL=https://fsm.yourdomain.com
CORS_ORIGINS=https://fsm.yourdomain.com
FRONTEND_URL=https://fsm.yourdomain.com

# ── Application Settings ──────────────────────────────────
APP_PORT=3213
APP_ENV=production
APP_NAME=FieldForce Pro

# ── External Database (PostgreSQL) ─────────────────────────
DB_HOST=your.database.server.ip
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=fieldforce_pro
DB_LOGGING=false

# ── Redis (Docker-internal — usually no changes needed) ────
REDIS_HOST=fsm-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT Secrets ────────────────────────────────────────────
#  Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_STRING
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# ── AWS S3 (file uploads) ─────────────────────────────────
AWS_S3_BUCKET=your-bucket-name
AWS_S3_REGION=your-region
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Mail (SMTP) ───────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@yourdomain.com

# ── AI Service ─────────────────────────────────────────────
AI_SERVICE_URL=http://fsm-ai:8000

# ── AI / LLM API Keys ─────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Celery (AI async tasks — uses Redis) ───────────────────
CELERY_BROKER_URL=redis://fsm-redis:6379/1
CELERY_RESULT_BACKEND=redis://fsm-redis:6379/2

# ── Qdrant Vector Store (optional, for RAG chatbot) ────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── ML Model Storage ──────────────────────────────────────
MODEL_DIR=data/models

# ── Account Security ──────────────────────────────────────
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=60

# ── Frontend Build Args (baked into React at build time) ──
#  IMPORTANT: Keep VITE_API_URL as /api — Nginx proxies it
VITE_API_URL=/api
VITE_APP_NAME=FieldForce Pro
