# App
APP_PORT=3213
APP_ENV=development

# Database — must match POSTGRES_DB in docker-compose.yml
DB_HOST=fsm-db
DB_PORT=5432
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=fieldforce_pro

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=fsm-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Frontend
FRONTEND_URL=http://localhost:3123
VITE_API_URL=/api
VITE_APP_NAME=FieldForce Pro
WEB_PORT=3123

# Mail (optional — leave blank for local dev)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@fieldforcepro.com

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1

# Payments (optional)
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI (optional)
GEMINI_API_KEY=
